{
  "name": "@parc-ferme/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "db:migrate:local": "wrangler d1 migrations apply parc-ferme --local",
    "db:migrate:remote": "wrangler d1 migrations apply parc-ferme --remote",
    "seed": "tsx scripts/seed.ts",
    "vapid": "tsx scripts/generate-vapid.ts"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@parc-ferme/shared": "workspace:*",
    "hono": "^4.13.22",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
